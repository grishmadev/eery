[
  {
    "name": "play_music",
    "description": "start playing music from the local library.",
    "parameters": {
      "type": "object",
      "properties": {}
    },
    "run": "vlc ~/Music",
    "keywords": ["music","song", "songs", "tune", "play"]
  },
  {
    "name": "set_volume",
    "description": "set the computer's volume to a percentage, e.g. 'set volume to 40'.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "volume percent, a number said in the request"
        }
      },
      "required": [
        "level"
      ]
    },
    "run": "amixer -q sset Master {level}%",
    "keywords": ["volume", "sound", "set", "audio"]
  },
  {
    "name": "last_session",
    "description": "open most recent project",
    "parameters": {
      "type": "object",
      "properties": {}
    },
    "run": "$HOME/.config/eery/last_project.sh; notify-send 'Opened Last Project'",
    "keywords": ["project", "session", "last", "work", "open"]
  }
]
